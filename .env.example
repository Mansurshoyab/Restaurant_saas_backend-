NODE_ENV=development
PORT=4000

# MongoDB
MONGO_URI=

# Redis
REDIS_URL=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_EXPIRES_IN_MIN=5
OTP_LENGTH=6

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info


# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_MAX_FILE_SIZE_MB=5


# BulkSMS BD
BULKSMS_API_KEY=
BULKSMS_SENDER_ID=
